{
  "name": "webcam-datamosher",
  "version": "1.0.0",
  "description": "Live webcam datamosher — glitchy video from your webcam, as a desktop app",
  "private": true,
  "main": "electron-main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "npx electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "build": {
    "appId": "dev.local.datamosher",
    "productName": "Datamosher",
    "files": [
      "index.html",
      "electron-main.cjs"
    ],
    "mac": {
      "category": "public.app-category.video",
      "extendInfo": {
        "NSCameraUsageDescription": "Datamosher needs your webcam to mosh it."
      }
    },
    "win": {
      "target": "portable"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
